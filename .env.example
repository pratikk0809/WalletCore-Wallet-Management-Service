# Postgres container credentials (used by docker-compose)
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet_pass
POSTGRES_DB=wallet_db

# App settings. Host is "db" because that's the service name in docker-compose.
APP_NAME=Wallet & Transaction Service
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://wallet:wallet_pass@db:5432/wallet_db

# JWT signing key. Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
# This placeholder is deliberately too short, so the app refuses to start until you replace it.
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Wallet currency for new users
DEFAULT_CURRENCY=INR

# Per-transaction amount limits, and the max a wallet may send out per UTC day
MIN_TRANSACTION_AMOUNT=0.01
MAX_TRANSACTION_AMOUNT=100000.00
DAILY_LIMIT=50000.00

# Rate limiting (requests per window; login/register per IP, money per user)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
MONEY_RATE_LIMIT=30